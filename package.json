    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.0.0",
    "fast-xml-parser": "^4.5.3",
    "http-status-code": "^2.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "p-limit": "^7.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
