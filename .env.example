PORT = 3000

# 데이터베이스 설정
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Cloud Tasks 설정
GCP_PROJECT_ID=ttorang
GCP_LOCATION=asia-northeast3
CLOUD_TASKS_QUEUE_NAME=conversion-queue
CLOUD_TASKS_SERVICE_ACCOUNT=
CLOUD_RUN_SERVICE_URL=

# Redis 설정 (Upstash)
REDIS_URL=
GCS_UPLOAD_SIGNED_URL_EXPIRES_SEC=900

# Conversion 성능 튜닝
# CONVERSION_RENDER_WORKERS: 렌더링 워커 수 (미설정 시 CPU 코어 수 기반으로 1~8 사이 자동 결정)
# CONVERSION_RENDER_WORKERS=
CONVERSION_UPLOAD_CONCURRENCY=8
PDF_RENDER_BACKEND=auto
VIDEO_CHUNK_DOWNLOAD_CONCURRENCY=8
VIDEO_HLS_UPLOAD_CONCURRENCY=12
GCS_NON_RESUMABLE_MAX_BYTES=8388608

# Slide 이미지 정책 (near_lossless | png_only)
SLIDE_IMAGE_POLICY=near_lossless
SLIDE_JPEG_QUALITY=95
SLIDE_JPEG_MIN_PNG_BYTES=2000000
SLIDE_JPEG_MIN_SAVING_RATIO=0.40
